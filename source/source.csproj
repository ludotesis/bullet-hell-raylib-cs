<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MiPrimerVideojuego</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
    <Content Include="sprites/**/*.*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="sonidos/**/*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
